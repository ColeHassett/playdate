package templates

import "fmt"

type BaseState struct {
	ServerError string
}

templ Base(body templ.Component) {
	<html lang="en">
		@head()
		<body class="container mt-5 bg-primary">
			@header()
			<main>
				@body
			</main>
		</body>
	</html>
}

templ head() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>PlayDate</title>
		// install htmx
		<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
		// bootstrap
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
		/>
		<link rel="stylesheet" href="custom-colors.css"/>
		// install fontawesome
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css"
			integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
	</head>
}

templ header() {
	<header class="bg-primary">
		<div class="container">
			<h1 class="display-1 text-center">
				<a class="text-decoration-none text-reset" href="/">PlayDate</a>
			</h1>
		</div>
	</header>
}

templ serverError(err string) {
	<div class="alert alert-danger" role="alert">
		<span>
			You have encountered a server error. The operation you tried failed, please include the information below when filing a bug report!
		</span>
		<br/>
		<span>
			{ err }
		</span>
	</div>
}

type field struct {
	name      string
	label     string
	fieldType string
	value     string
	err       string
	helpText  string
	required  bool
	readonly  bool
}

// formField
templ formField(f field) {
	<div class="mb-3">
		<label class="form-label" for={ f.label }>{ f.name }</label>
		<input
			if f.err != "" {
				class="form-control is-invalid"
			} else {
				class="form-control"
			}
			type={ f.fieldType }
			name={ f.label }
			value={ f.value }
			if f.required {
				required
			}
			else
			if f.readonly {
				readonly
			}
		/>
		if f.helpText != "" {
			<small id={ fmt.Sprintf("%sHelp", f.label) } class="form-text text-muted">
				{ f.helpText }
			</small>
		}
		if f.err != "" {
			<div class="invalid-feedback">{ f.err }</div>
		} else {
			<div class="valid-feedback"></div>
		}
	</div>
}
